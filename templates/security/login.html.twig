{% extends 'base.html.twig' %}
{% block title %}
	Sign in
{% endblock %}
{% block body %}
	<div class="row justify-content-center">
		<div class="col-12 col-sm-8 col-md-6 col-lg-4">
			<div class="mb-4">
				<div class="fw-bold text-primary fs-4 mb-3">
					THE APP
				</div>
				<p class="text-body-secondary mb-4">
					Log into account
				</p>
			</div>
			{% if error %}
				<div class="alert alert-danger" role="alert">
					{{ error.messageKey|trans(error.messageData, 'security') }}
				</div>
			{% endif %}
			<form method="post">
				<div class="mb-3">
					<div class="form-floating position-relative">
						<input type="email" value="{{ last_username }}" name="_username" id="username" class="form-control pe-5" placeholder="Email" autocomplete="email" required autofocus>
						<label for="username">
							Email
						</label>
						<span class="form-field-icon position-absolute top-50 end-0 translate-middle-y me-3 text-body-secondary" aria-hidden="true">
							<i class="bi bi-envelope"></i>
						</span>
					</div>
				</div>
				<div class="mb-3">
					<div class="form-floating position-relative">
						<input type="password" name="_password" id="password" class="form-control pe-5" placeholder="Password" autocomplete="current-password" required>
						<label for="password">
							Password
						</label>
						<button type="button" id="toggle-password" class="form-field-icon btn border-0 position-absolute top-50 end-0 translate-middle-y me-3 p-0" data-password-toggle="password" aria-label="Show password">
							<i id="password-icon" class="bi bi-eye"></i>
						</button>
					</div>
				</div>
				<div class="form-check mb-3">
					<input class="form-check-input" type="checkbox" name="_remember_me" id="_remember_me">
					<label class="form-check-label" for="_remember_me">
						Remember me
					</label>
				</div>
				<input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
				<button class="btn btn-primary w-100 py-2" type="submit">
					Sign in
				</button>
			</form>
			<div class="text-center mt-3">
				<small class="text-body-secondary">
					Don't have an account?
					<a href="{{ path('app_register') }}" class="text-decoration-none">
						Sign up
					</a>
				</small>
			</div>
		</div>
	</div>
{% endblock %}
